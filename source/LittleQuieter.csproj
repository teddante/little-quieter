<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AssemblyName>Little Quieter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LittleQuieter.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.5.2</Version>
    <Description>Local microphone loudness monitor with a steady alarm tone.</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <EmbeddedResource Include="Uninstall.ps1" LogicalName="LittleQuieter.Uninstall.ps1" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="LittleQuieter.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
