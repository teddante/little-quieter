<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Little Quieter</AssemblyName>
    <RootNamespace>LittleQuieter</RootNamespace>
    <StartupObject>LittleQuieter.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LittleQuieter.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <Version>1.3.2</Version>
    <Description>Local microphone loudness monitor with a steady alarm tone.</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <Compile Remove="Checks.cs;Benchmarks.cs" />
  </ItemGroup>
</Project>
